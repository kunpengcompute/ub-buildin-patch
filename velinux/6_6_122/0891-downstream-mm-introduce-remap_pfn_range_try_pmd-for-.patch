+				pfn + (addr >> PAGE_SHIFT), prot, page_shift)) {
+			continue;
+		}
+#endif
 		err = remap_pte_range(mm, pmd, addr, next,
 				pfn + (addr >> PAGE_SHIFT), prot);
 		if (err)
@@ -2388,7 +2444,7 @@ static inline int remap_pmd_range(struct mm_struct *mm, pud_t *pud,
 
