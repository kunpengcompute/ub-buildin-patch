+		return -ENODEV;
+
+	return ub_cfg_ops.cfg_read_dword(uent, pos, val);
+}
+EXPORT_SYMBOL_GPL(ub_cfg_read_dword);
+
+int ub_cfg_write_byte(struct ub_entity *uent, u64 pos, u8 val)
+{
+	if (!ub_cfg_ops.cfg_write_byte)
