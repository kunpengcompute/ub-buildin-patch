+++ b/drivers/iommu/iommufd/iommufd_private.h
@@ -524,6 +524,9 @@ static inline int iommufd_hwpt_replace_device(struct iommufd_device *idev,
 	return iommu_group_replace_domain(idev->igroup->group, hwpt->domain);
