index 4a91ef320e08..05ef12dd16f7 100644
--- a/config.aarch64-64k
+++ b/config.aarch64-64k
@@ -11002,3 +11002,8 @@ CONFIG_UB_UBUS_USI=y
 CONFIG_ARM_GIC_V3_ITS_UBUS=y
 
 # end of unified bus
+
+# UMMU
+CONFIG_UB_UMMU_CORE=y
+CONFIG_UB_UMMU_CORE_DRIVER=m
+# end of UMMU
diff --git a/drivers/iommu/Kconfig b/drivers/iommu/Kconfig
index 4c997a005c24..ef9e1ded6149 100644
--- a/drivers/iommu/Kconfig
