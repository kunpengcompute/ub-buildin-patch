diff --git a/drivers/iommu/hisilicon/Kconfig b/drivers/iommu/hisilicon/Kconfig
new file mode 100644
index 000000000000..76acd888b65e
--- /dev/null
+++ b/drivers/iommu/hisilicon/Kconfig
